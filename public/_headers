# hreflang URLs must be absolute (RFC 8288 context is fine relative, but
# Google ignores relative hreflang link headers). The codes match the
# on-page <link> tags: tr-TR / en / x-default.
# CSP: static.cloudflareinsights.com + cloudflareinsights.com allow the
# Cloudflare Web Analytics beacon the CSP used to silently block.
/*
  Link: <https://soleach.com/llms.txt>; rel="describedby"; type="text/plain", <https://soleach.com/llms-full.txt>; rel="describedby"; type="text/plain", <https://soleach.com/.well-known/api-catalog>; rel="api-catalog"; type="application/linkset+json", <https://soleach.com/.well-known/agent-skills/index.json>; rel="service-desc"; type="application/json", <https://soleach.com/sitemap.xml>; rel="sitemap"; type="application/xml", <https://soleach.com/tr>; rel="alternate"; hreflang="tr-TR", <https://soleach.com/en>; rel="alternate"; hreflang="en", <https://soleach.com/tr>; rel="alternate"; hreflang="x-default"
  Content-Signal: search=yes, ai-input=yes, ai-train=yes
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; frame-src https://docs.google.com https://www.google.com https://www.youtube-nocookie.com https://www.youtube.com https://www.instagram.com https://www.tiktok.com; connect-src 'self' https://cloudflareinsights.com https://thcbkozrgmyqtqjeptbd.supabase.co; form-action 'self' https://docs.google.com;

/oauth/*
  Cache-Control: no-store
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer

# Next's hashed build assets never change under the same URL — let repeat
# visitors and the edge cache keep them for a year instead of Pages'
# default 4-hour revalidation.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/.well-known/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

# Extensionless, so Pages would otherwise guess application/octet-stream.
/.well-known/api-catalog
  Content-Type: application/linkset+json

# SEP-2127 defines its own media type; .json would otherwise win.
/.well-known/mcp/server-card.json
  Content-Type: application/mcp-server-card+json

# Chrome's Private Prefetch Proxy fetches this before it will prefetch anything
# and treats a non-matching Content-Type exactly like a refusal.
/.well-known/traffic-advice
  Content-Type: application/trafficadvice+json

# The Markdown twins are an implementation detail of content negotiation — the
# canonical address of every page is its HTML URL. Keep them out of the index
# so they never compete with it. functions/_middleware.js strips this header
# when it serves a twin under negotiation, so /tr itself stays indexable.
/*.md
  X-Robots-Tag: noindex
  Access-Control-Allow-Origin: *

/llms.txt
  Access-Control-Allow-Origin: *

/llms-full.txt
  Access-Control-Allow-Origin: *
