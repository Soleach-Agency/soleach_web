# Hand-written rules. `scripts/route-aliases.mjs` appends a generated block to
# out/_redirects after `next build` — the cross-locale slug aliases for every
# post and concept. Never hand-edit those; edit the script.
#
# Two things worth knowing about Pages' matcher, both learned from 404 logs:
#   * it is NOT trailing-slash insensitive. `/services` matched and `/services/`
#     404'd, so every static rule below is listed in both spellings.
#   * first match wins, so the specific blocks come before `/blog/*`.

# www → apex (takes effect once www.soleach.com is attached to the Pages
# project as a custom domain).
https://www.soleach.com/* https://soleach.com/:splat 301

# Feed autodiscovery. Readers and agents guess these five spellings before they
# ever look at <link rel="alternate">; all of them are WordPress muscle memory.
# Ahead of the /blog/* rule below, which would otherwise swallow /blog/feed.
/feed  /tr/rss.xml  301
/feed/  /tr/rss.xml  301
/feed.xml  /tr/rss.xml  301
/rss  /tr/rss.xml  301
/rss/  /tr/rss.xml  301
/rss.xml  /tr/rss.xml  301
/atom.xml  /tr/rss.xml  301
/index.xml  /tr/rss.xml  301
/blog/feed  /tr/rss.xml  301
/blog/rss.xml  /tr/rss.xml  301
/tr/feed  /tr/rss.xml  301
/en/feed  /en/rss.xml  301

# Apple touch icon. app/apple-icon.png is advertised in a <link> tag, but iOS,
# link-preview services and crawlers probe these fixed paths at the root
# regardless of the markup — four of them show up in the 404 log.
/apple-touch-icon.png  /apple-icon.png  301
/apple-touch-icon-precomposed.png  /apple-icon.png  301
/apple-touch-icon-120x120.png  /apple-icon.png  301
/apple-touch-icon-120x120-precomposed.png  /apple-icon.png  301
/apple-touch-icon-180x180.png  /apple-icon.png  301
/apple-touch-icon-152x152.png  /apple-icon.png  301
/apple-touch-icon-76x76.png  /apple-icon.png  301

# Turkish spellings of the section slugs.
#
# The routes are English (/tr/services) but the concepts hub is Turkish
# (/tr/kavramlar), and that inconsistency is an open invitation to guess: the
# 404 log has crawlers — including user-triggered AI fetchers — asking for
# /hizmetler and /iletisim. Permanent 301s, because a Turkish word can only
# ever mean the Turkish locale.
/hizmetler  /tr/services  301
/hizmetler/  /tr/services  301
/hizmetlerimiz  /tr/services  301
/hizmetlerimiz/  /tr/services  301
/tr/hizmetler  /tr/services  301
/tr/hizmetler/  /tr/services  301
/tr/hizmetlerimiz  /tr/services  301
/hakkimizda  /tr/about  301
/hakkimizda/  /tr/about  301
/tr/hakkimizda  /tr/about  301
/tr/hakkimizda/  /tr/about  301
/iletisim  /tr/contact  301
/iletisim/  /tr/contact  301
/tr/iletisim  /tr/contact  301
/tr/iletisim/  /tr/contact  301
/bize-ulasin  /tr/contact  301
/tr/bize-ulasin  /tr/contact  301

# Locale-less entry points → Turkish default (mirrors the root redirect).
# People and AI engines routinely strip the locale segment from links.
/  /tr  302
/blog  /tr/blog  302
/blog/  /tr/blog  302
/blog/*  /tr/blog/:splat  302
/services  /tr/services  302
/services/  /tr/services  302
/about  /tr/about  302
/about/  /tr/about  302
/contact  /tr/contact  302
/contact/  /tr/contact  302
/home  /tr  302
/tr/home  /tr  302
/en/home  /en  302

# Concepts — the section slug is localized, so each spelling maps to its own
# locale. No cross-locale /* splats: detail slugs diverge and would 404.
/kavramlar  /tr/kavramlar  302
/kavramlar/*  /tr/kavramlar/:splat  302
/concepts  /en/concepts  302
/concepts/*  /en/concepts/:splat  302
/tr/concepts  /tr/kavramlar  301
/tr/concepts/*  /tr/kavramlar/:splat  301
/en/kavramlar  /en/concepts  301
/en/kavramlar/*  /en/concepts/:splat  301
